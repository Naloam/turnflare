{
  "name": "@turnflare/cli",
  "version": "0.2.1",
  "type": "module",
  "description": "Turnflare 命令行工具：扫描、统计、报告导出",
  "bin": {
    "turnflare": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/bin.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@turnflare/api": "workspace:*",
    "@turnflare/core": "workspace:*",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
