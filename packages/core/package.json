{
  "name": "@turnflare/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Turnflare \u6838\u5fc3\uff1aClaude Code \u4f1a\u8bdd\u89e3\u6790\u3001\u7edf\u8ba1\u4e0e\u6210\u672c\u5f15\u64ce\uff08\u96f6\u8fd0\u884c\u65f6\u4f9d\u8d56\uff09",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@turnflare/contracts": "workspace:*"
  },
  "license": "MIT"
}
