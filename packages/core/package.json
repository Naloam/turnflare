{
  "name": "@turnflare/core",
  "version": "0.2.1",
  "type": "module",
  "description": "Turnflare 核心：Claude Code 会话解析、统计与成本引擎（零运行时依赖）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@turnflare/contracts": "workspace:*"
  },
  "license": "MIT"
}
